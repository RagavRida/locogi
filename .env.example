# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# upstash.com → Create Database (pick ap-south-1 Mumbai) → copy Redis URL
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# ─── NVIDIA NIM (free tier — LLM + embeddings) ────────────────────────────────
# build.nvidia.com → Get API Key
NIM_API_KEY=nvapi-YOUR_KEY

# ─── JWT secrets ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# ─── MSG91 (OTP SMS + WhatsApp fallback) ──────────────────────────────────────
# Optional in development — OTP is logged to console instead
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_WA_NUMBER=

# ─── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
